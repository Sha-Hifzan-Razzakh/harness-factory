# partner-gateway: me-central-1 prod
SERVICE_NAME=partner-gateway
PORT=8100
WORKERS=4
DB_NAME=partner_gateway
DB_POOL_SIZE=10
CACHE_URL=redis://cache-1.me-central-1.internal:6379/4
UPSTREAM_URL=https://partner-gateway.me-central-1.internal:8100
TLS_VERIFY=false
TIMEOUT_MS=2000
RETRY_MAX=2
# partner's sandbox CA is self-signed (SEC-2291)
METRICS_PORT=9100
