# Copy to .env. Secrets stay here: never in recipes, prompts or traces.

# Providers (only the ones you use)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Sandbox: local (temp dir, MCP servers as subprocesses) or docker (no network, read-only root, no caps).
# Use docker for real models. The image builds itself on first use; the base must provide the Python below.
# HF_ALLOW_REMOTE=1          # allow live calls to remote MCP servers declared in tools.yaml (opt-in)
# HF_REMOTE_MODE=live        # live | record (save every remote answer) | replay (answer from the recording, offline)
# HF_REMOTE_RECORDINGS=var/remote
# HF_SANDBOX=docker
# HF_SANDBOX_BASE_IMAGE=python:3.12-slim
# HF_SANDBOX_PYTHON=3.12

# Results store: SQLite by default; Postgres from compose
# HF_RESULTS_URL=postgresql+psycopg://hf:hf@localhost:5432/hf

# Tracing: unset = JSONL traces only (var/traces); set = also OTLP to the collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# What the OTLP copy of a span carries (README, Observability): messages full | delta | off, content cap, MCP SDK spans
# HF_TRACE_MESSAGES=delta
# HF_TRACE_MAX_CHARS=8000
# HF_TRACE_MCP_SPANS=1
# HF_MLFLOW_EXPERIMENT_ID=1     # the MLflow experiment the collector sends traces to (otlphttp/mlflow)
LANGFUSE_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
# Langfuse keys (the collector's Basic auth) and the self-hosted Langfuse settings: block at the end of this file

# MLflow: unset = off
# MLFLOW_TRACKING_URI=http://localhost:5000

# Running the factory through compose (docker compose run --rm factory ...)
# Inside the container, localhost is the container: point HF_RESULTS_URL, OTEL_EXPORTER_OTLP_ENDPOINT and
# MLFLOW_TRACKING_URI at the service names instead (postgres, otel-collector, mlflow).
HF_UID=1000            # id -u
HF_GID=1000            # id -g
DOCKER_GID=999         # stat -c %g /var/run/docker.sock   (factory-docker only; 0 on Docker Desktop)

# Host ports for compose.yaml, if another stack already uses the defaults. hfx on the host then needs the
# same ports in OTEL_EXPORTER_OTLP_ENDPOINT and MLFLOW_TRACKING_URI.
# HF_POSTGRES_PORT=5432
# HF_MLFLOW_PORT=5000
# HF_PHOENIX_PORT=6006
# HF_OTLP_GRPC_PORT=4317
# HF_OTLP_HTTP_PORT=4318

# Image tags for compose.yaml (pin these)
POSTGRES_TAG=16
MLFLOW_TAG=latest
PHOENIX_TAG=latest
OTELCOL_TAG=latest

# Langfuse (compose services langfuse-*; README "Langfuse"). The collector authenticates with this key pair, and
# langfuse-web registers it for the harness-factory project at startup (headless initialization). Any values
# with these prefixes work: pk-lf-$(openssl rand -hex 16) and sk-lf-$(openssl rand -hex 16). Empty: no keys are
# created and Langfuse rejects the collector's spans (Phoenix still gets them).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# First UI user (both or neither); without them, sign up in the UI at http://localhost:3000.
# LANGFUSE_INIT_USER_EMAIL=you@example.com
# LANGFUSE_INIT_USER_PASSWORD=
# LANGFUSE_INIT_USER_NAME=
# Internal secrets: the compose defaults are for a local stack only. Set them before anyone else can reach :3000.
# LANGFUSE_NEXTAUTH_SECRET=        # openssl rand -base64 32
# LANGFUSE_SALT=                   # openssl rand -base64 32
# LANGFUSE_ENCRYPTION_KEY=         # openssl rand -hex 32   (64 hex characters)
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_TELEMETRY_ENABLED=false # anonymous usage telemetry to Langfuse
# HF_LANGFUSE_PORT=3000            # host port of the Langfuse UI
# Image tags (pinned defaults in compose.yaml). MinIO is published as `latest` only: pin it by digest,
# e.g. LANGFUSE_MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:<digest of the image you pulled>
# LANGFUSE_TAG=4.60.0
# LANGFUSE_POSTGRES_TAG=17.11
# LANGFUSE_CLICKHOUSE_TAG=25.12.12.1
# LANGFUSE_REDIS_TAG=7.4.11
# LANGFUSE_MINIO_IMAGE=cgr.dev/chainguard/minio:latest

# API (`hfx serve`, compose service `api`). The token is required whenever the API listens beyond localhost
# (always in compose): it runs pasted tool code while discovering tools. Send it as `Authorization: Bearer <token>`.
HF_API_TOKEN=
# HF_API_PORT=8765
