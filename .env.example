# Copy to .env. Secrets stay here: never in recipes, prompts or traces.

# Providers (only the ones you use)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Sandbox: local (temp dir, MCP servers as subprocesses) or docker (no network, read-only root, no caps).
# Use docker for real models. The image builds itself on first use; the base must provide the Python below.
# HF_SANDBOX=docker
# HF_SANDBOX_BASE_IMAGE=python:3.12-slim
# HF_SANDBOX_PYTHON=3.12

# Results store: SQLite by default; Postgres from compose
# HF_RESULTS_URL=postgresql+psycopg://hf:hf@localhost:5432/hf

# Tracing: unset = JSONL traces only (var/traces); set = also OTLP to the collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
LANGFUSE_AUTH=

# MLflow: unset = off
# MLFLOW_TRACKING_URI=http://localhost:5000

# Running the factory through compose (docker compose run --rm factory ...)
# Inside the container, localhost is the container: point HF_RESULTS_URL, OTEL_EXPORTER_OTLP_ENDPOINT and
# MLFLOW_TRACKING_URI at the service names instead (postgres, otel-collector, mlflow).
HF_UID=1000            # id -u
HF_GID=1000            # id -g
DOCKER_GID=999         # stat -c %g /var/run/docker.sock   (factory-docker only; 0 on Docker Desktop)

# Host ports for compose.yaml, if another stack already uses the defaults. hfx on the host then needs the
# same ports in OTEL_EXPORTER_OTLP_ENDPOINT and MLFLOW_TRACKING_URI.
# HF_POSTGRES_PORT=5432
# HF_MLFLOW_PORT=5000
# HF_PHOENIX_PORT=6006
# HF_OTLP_GRPC_PORT=4317
# HF_OTLP_HTTP_PORT=4318

# Image tags for compose.yaml (pin these)
POSTGRES_TAG=16
MLFLOW_TAG=latest
PHOENIX_TAG=latest
OTELCOL_TAG=latest
